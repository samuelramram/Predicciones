# ============================================================================
#  .gitignore — Predicciones Mundial 2026
# ============================================================================

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# ----- Virtualenvs -----
.venv/
venv/
env/
ENV/

# ----- IDE / editores -----
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ----- Secretos -----
.env
*.env
!.env.example
credentials.json
tokens.json
api_keys.json

# ----- Datos crudos / cache (NO versionar) -----
data/raw/*
!data/raw/.gitkeep
# Closing-line store IS versioned: the scheduled odds workflow commits it back so
# it persists across runs (Actions disk is ephemeral) and builds an auditable history.
!data/raw/odds_closing_line.json
data/processed/*
!data/processed/.gitkeep
# Fitted model artifacts (output of fit_model) — versionados porque son caros
# de regenerar y son input directo de picks. Stale-rebuild es trivial: re-correr fit_model.
!data/processed/team_strengths.json

# ----- Outputs generados -----
outputs/*
!outputs/.gitkeep

# ----- Logs y debug -----
logs/
*.log
*_log.txt
debug_*.txt
debug_*.log

# ----- Notebooks: stripear output antes de commit -----
*.ipynb_checkpoints/

# ----- Misc -----
*.bak
*.tmp
