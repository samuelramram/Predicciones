# ============================================================================
#  .gitignore — Predicciones Mundial 2026
# ============================================================================

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# ----- Virtualenvs -----
.venv/
venv/
env/
ENV/

# ----- IDE / editores -----
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ----- Secretos -----
.env
*.env
!.env.example
credentials.json
tokens.json
api_keys.json

# ----- Datos crudos / cache (NO versionar) -----
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# ----- Outputs generados -----
outputs/*
!outputs/.gitkeep

# ----- Logs y debug -----
logs/
*.log
*_log.txt
debug_*.txt
debug_*.log

# ----- Notebooks: stripear output antes de commit -----
*.ipynb_checkpoints/

# ----- Misc -----
*.bak
*.tmp
