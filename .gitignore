# ============================================================================
#  .gitignore — Predicciones Liga MX
# ============================================================================

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/
.nox/

# ----- Virtualenvs -----
.venv/
venv/
env/
ENV/

# ----- IDE / Editores -----
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ----- Environment / Secretos -----
.env
*.env
!.env.example
credentials.json
tokens.json

# ----- Datos grandes / raw (no versionar) -----
data/raw/*.json
data/processed/*.json
data/cache/*.json

# ----- Logs y outputs de depuración (en raíz) -----
logs/
*.log
*_log.txt
*_output.txt
pipeline_run_output.txt
debug_*.txt
debug_*.log

# ----- Reportes técnicos generados por jornada -----
# Los reportes por jornada se regeneran; se mantienen en outputs/ pero NO se versionan.
# Si quieres archivar uno en particular, muévelo a docs/archive/ y commit a mano.
reporte_tecnico_jornada_*.md
reports/

# ----- Reglas de versionado selectivo de Markdown -----
# Por defecto ignoramos .md sueltos en raíz, pero conservamos:
#   README.md, CHANGELOG.md, CONTRIBUTING.md en raíz
#   Todos los docs/**/*.md
/*.md
!/README.md
!/CHANGELOG.md
!/CONTRIBUTING.md
!/config_calibracion_modelo.md

# ----- Scripts de debug/inspección no versionados -----
scripts/debug_*.py
scripts/inspect_*.py
temp*.py
/test_*.py

# ----- Outputs generados del pipeline -----
# Mantenemos estructura pero no los archivos generados.
outputs/*.csv
outputs/*.txt
outputs/fingerprint_*.json
outputs/reporte_tecnico_*.md
# Mantener el placeholder para que la carpeta exista:
!outputs/.gitkeep

# ----- Sistema operativo / misc -----
.ipynb_checkpoints/
*.bak
*.tmp
