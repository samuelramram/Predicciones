# Copia este archivo a .env (gitignored) y llena los valores reales.
# Solo se necesitan las APIs que vayas a usar; el modelo cae a fallbacks si faltan.

# TheSportsDB — fuente primaria de fixtures y live results.
# Misma key que usas en las edge functions de Lovable para Liga MX.
# Tier Patreon (~$9/mes) habilita Liga MX completa + Mundial.
THESPORTSDB_API_KEY=pega_tu_key_aqui

# (Opcional) API-Football si decides hacer upgrade para alineaciones + minuto exacto.
# Tier Free 100 req/día; Pro desde ~$19/mes en https://www.api-football.com/
API_FOOTBALL_KEY=pega_tu_key_aqui

# (Opcional) The Odds API si decides pagar por odds programáticos.
# https://the-odds-api.com/ — desde ~$30/mes.
THE_ODDS_API_KEY=pega_tu_key_aqui
